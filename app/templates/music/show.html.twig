{% extends 'base.html.twig' %}

{% block title %}{{ music.name }}{% endblock %}

{% block body %}
<div class="container">
    <a href="{{ path('app_music') }}" class="small"><i class="bi bi-arrow-left"></i> Catalogue</a>

    <div class="row g-4 mt-1">
        <div class="col-lg-8">
            {% if music.youtubeId %}
                <div class="ratio ratio-16x9 mb-3">
                    <iframe src="https://www.youtube-nocookie.com/embed/{{ music.youtubeId }}" title="{{ music.name }}"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture" allowfullscreen></iframe>
                </div>
            {% else %}
                <div class="ym-card p-5 text-center mb-3">
                    <i class="bi bi-music-note-beamed fs-1 text-secondary"></i>
                    <p class="mt-2"><a href="{{ music.url }}" target="_blank" rel="noopener noreferrer">Écouter sur le site d'origine <i class="bi bi-box-arrow-up-right"></i></a></p>
                </div>
            {% endif %}

            <h1 class="h2 mb-1">{{ music.name }}</h1>
            <p class="text-secondary fs-5">{{ music.auteur ?: 'Artiste inconnu' }}</p>

            <div class="d-flex flex-wrap gap-2 align-items-center">
                {% if music.category %}
                    <a class="badge badge-cat text-decoration-none" style="background: {{ music.category.color }}"
                       href="{{ path('app_music', {categorie: music.category.id}) }}">{{ music.category.name }}</a>
                {% endif %}
                <small class="text-secondary">
                    Ajouté {% if music.owner %}par {{ music.owner.displayName }} {% endif %}le {{ music.createdAt|date('d/m/Y') }}
                </small>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                {{ include('music/_favorite_button.html.twig') }}
                <a class="btn btn-outline-light" href="{{ music.url }}" target="_blank" rel="noopener noreferrer"><i class="bi bi-box-arrow-up-right"></i> Ouvrir le lien</a>
                {% if is_granted('MUSIC_EDIT', music) %}
                    <a class="btn btn-outline-warning" href="{{ path('app_music_edit', {id: music.id}) }}"><i class="bi bi-pencil"></i> Modifier</a>
                {% endif %}
                {% if is_granted('MUSIC_DELETE', music) %}
                    <form method="post" action="{{ path('app_music_delete', {id: music.id}) }}" onsubmit="return confirm('Supprimer définitivement ce morceau ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-music-' ~ music.id) }}">
                        <button class="btn btn-outline-danger"><i class="bi bi-trash"></i> Supprimer</button>
                    </form>
                {% endif %}
            </div>
        </div>

        <aside class="col-lg-4">
            {% if app.user %}
                <div class="ym-card p-3 mb-4">
                    <h2 class="h6"><i class="bi bi-plus-circle"></i> Ajouter à une playlist</h2>
                    {% if app.user.playlists is empty %}
                        <p class="small text-secondary mb-2">Vous n'avez pas encore de playlist.</p>
                        <a class="btn btn-sm btn-gradient" href="{{ path('app_playlist_new') }}">Créer une playlist</a>
                    {% else %}
                        <form method="post" action="{{ path('app_music_add_to_playlist', {id: music.id}) }}" class="d-flex gap-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('add-playlist-' ~ music.id) }}">
                            <select name="playlist" class="form-select form-select-sm">
                                {% for playlist in app.user.playlists %}
                                    <option value="{{ playlist.id }}">{{ playlist.name }}{{ playlist.hasMusic(music) ? ' ✓' }}</option>
                                {% endfor %}
                            </select>
                            <button class="btn btn-sm btn-gradient">Ajouter</button>
                        </form>
                    {% endif %}
                </div>
            {% endif %}

            {% if similar is not empty %}
                <h2 class="h6 mb-3">Dans la même catégorie</h2>
                <div class="list-group">
                    {% for item in similar %}
                        <a class="list-group-item list-group-item-action d-flex gap-2 align-items-center" href="{{ path('app_music_show', {id: item.id}) }}">
                            {% if item.thumbnailUrl %}
                                <img src="{{ item.thumbnailUrl }}" alt="" width="64" class="rounded" loading="lazy">
                            {% endif %}
                            <span>
                                <span class="d-block fw-semibold">{{ item.name }}</span>
                                <small class="text-secondary">{{ item.auteur }}</small>
                            </span>
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </aside>
    </div>
</div>
{% endblock %}

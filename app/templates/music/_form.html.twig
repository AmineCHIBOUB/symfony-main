{{ form_start(form) }}
    <div class="row">
        <div class="col-md-6">{{ form_row(form.name) }}</div>
        <div class="col-md-6">{{ form_row(form.auteur) }}</div>
    </div>
    {{ form_row(form.url) }}
    {{ form_row(form.category) }}
